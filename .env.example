# Plantilla de credenciales para el despliegue en AWS.
#
# Este archivo es solo de referencia local: copialo como ".env" y completa
# los valores reales para tus propias pruebas (por ejemplo, para correr
# comandos de AWS CLI a mano). El ".env" queda ignorado por git.
#
# IMPORTANTE: GitHub Actions NO lee este archivo. Los valores reales deben
# cargarse como "Secrets" del repositorio en:
#   Settings -> Secrets and variables -> Actions -> New repository secret
# usando exactamente estos mismos nombres, para que el workflow
# .github/workflows/deploy.yml pueda usarlos.

# --- Credenciales de AWS (usuario IAM con permisos de push a ECR) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Amazon ECR ---
# Nombre del repositorio ECR (no la URL completa), ej: digitalfix-frontend
ECR_REPOSITORY=digitalfix-frontend

# --- EC2 donde corre el contenedor del frontend ---
EC2_HOST=
EC2_USERNAME=ec2-user
# Contenido completo de la llave privada .pem usada para SSH
EC2_SSH_PRIVATE_KEY=
